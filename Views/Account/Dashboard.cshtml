@{
    ViewData["Title"] = "Mon Espace Client";
}

<div class="container py-5">
    <h1 class="mb-4">Mon espace client</h1>

    <!-- Section 1: Résumé -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h3 class="card-title">Bonjour, Salma 👋</h3>
                    <p class="text-muted mb-1">Salma.client@email.com</p>
                    <p class="mb-0">Client depuis 2025</p>
                </div>
                <div class="col-md-4 text-md-end">
                    <div class="stat-box">
                        <h2 class="text-primary">@ViewBag.TotalLocations</h2>
                        <p class="text-muted mb-0">Locations totales</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Section 2: Mes informations -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Mes informations personnelles</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Nom</label>
                    <input type="text" class="form-control" value="Ait haji" readonly id="lastNameDisplay">
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Prénom</label>
                    <input type="text" class="form-control" value="Salma" readonly id="firstNameDisplay">
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Email</label>
                    <input type="email" class="form-control" value="Salma.client@email.com" readonly>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Téléphone</label>
                    <input type="tel" class="form-control" value="+212 6 XX XX XX XX" readonly id="phoneDisplay">
                </div>
                <div class="col-12">
                    <a href="#" class="text-decoration-none" data-bs-toggle="modal" data-bs-target="#passwordModal">
                        <i class="bi bi-key"></i> Modifier mon mot de passe
                    </a>
                </div>
            </div>
            <button class="btn btn-primary mt-3" id="editInfoBtn">
                <i class="bi bi-pencil"></i> Modifier mes informations
            </button>
        </div>
    </div>

    <!-- Section 3: Historique de locations -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Historique de locations</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Véhicule</th>
                            <th>Période</th>
                            <th>Prix total</th>
                            <th>Statut</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Dacia Duster</td>
                            <td>01/12/2025 → 05/12/2025</td>
                            <td>1600 DH</td>
                            <td><span class="badge bg-success">Confirmée</span></td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#detailsModal">
                                    <i class="bi bi-eye"></i> Détails
                                </button>
                                <button class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-download"></i> PDF
                                </button>
                            </td>
                        </tr>
                        <tr>
                            <td>Renault Clio</td>
                            <td>10/11/2025 → 12/11/2025</td>
                            <td>600 DH</td>
                            <td><span class="badge bg-secondary">Terminée</span></td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" disabled>
                                    <i class="bi bi-eye"></i> Détails
                                </button>
                                <button class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-download"></i> Facture
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Section 4: Sécurité -->
    <div class="card border-danger">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="mb-1">Sécurité du compte</h6>
                    <p class="text-muted small mb-0">Gérez l'accès à votre compte</p>
                </div>
                <div>
                    <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger me-2">
                        <i class="bi bi-box-arrow-right"></i> Se déconnecter
                    </a>
                    <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                        <i class="bi bi-trash"></i> Supprimer mon compte
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Modification des informations -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Modifier mes informations</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="editForm">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nom</label>
                        <input type="text" class="form-control" id="lastNameEdit" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Prénom</label>
                        <input type="text" class="form-control" id="firstNameEdit" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Téléphone</label>
                        <input type="tel" class="form-control" id="phoneEdit" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary">Enregistrer</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Modification mot de passe -->
<div class="modal fade" id="passwordModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Modifier mon mot de passe</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="passwordForm">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Mot de passe actuel</label>
                        <input type="password" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Nouveau mot de passe</label>
                        <input type="password" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Confirmer le nouveau mot de passe</label>
                        <input type="password" class="form-control" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary">Mettre à jour</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Remplir les champs d'édition avec les valeurs actuelles
            $('#firstNameEdit').val($('#firstNameDisplay').val());
            $('#lastNameEdit').val($('#lastNameDisplay').val());
            $('#phoneEdit').val($('#phoneDisplay').val());

            // Ouvrir modal d'édition
            $('#editInfoBtn').click(function() {
                $('#editModal').modal('show');
            });

            // Soumission du formulaire d'édition
            $('#editForm').submit(function(e) {
                e.preventDefault();

                // Mettre à jour les champs d'affichage
                $('#firstNameDisplay').val($('#firstNameEdit').val());
                $('#lastNameDisplay').val($('#lastNameEdit').val());
                $('#phoneDisplay').val($('#phoneEdit').val());

                // Simuler sauvegarde
                alert('Informations mises à jour avec succès!');
                $('#editModal').modal('hide');
            });

            // Soumission du formulaire de mot de passe
            $('#passwordForm').submit(function(e) {
                e.preventDefault();
                alert('Mot de passe mis à jour avec succès!');
                $('#passwordModal').modal('hide');
            });
        });
    </script>
}